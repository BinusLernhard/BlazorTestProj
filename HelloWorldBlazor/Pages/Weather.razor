@page "/weather"
@inject HttpClient Http

<PageTitle>Weather</PageTitle>

<div class="container mt-5">
    <h1>🌤️ Weather Forecast</h1>

    <p class="text-muted">Sample weather data loaded from JSON file.</p>

    @if (forecasts == null)
    {
        <div class="alert alert-info">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <span class="ms-2">Loading weather data...</span>
        </div>
    }
    else if (forecasts.Length == 0)
    {
        <div class="alert alert-warning">
            No weather data available.
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>📅 Date</th>
                                <th>🌡️ Temp. (°C)</th>
                                <th>🌡️ Temp. (°F)</th>
                                <th>📝 Summary</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var forecast in forecasts)
                            {
                                <tr>
                                    <td>@forecast.Date.ToShortDateString()</td>
                                    <td>
                                        <span class="badge" style="@GetTempBadgeClass(forecast.TemperatureC)">
                                            @forecast.TemperatureC°C
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge" style="@GetTempBadgeClass(forecast.TemperatureC)">
                                            @forecast.TemperatureF°F
                                        </span>
                                    </td>
                                    <td>@forecast.Summary</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card bg-light">
                    <div class="card-body">
                        <h5 class="card-title">📊 Statistics</h5>
                        <p><strong>Average Temperature:</strong> @Math.Round(forecasts.Average(f => f.TemperatureC), 1)°C</p>
                        <p><strong>Highest:</strong> @forecasts.Max(f => f.TemperatureC)°C</p>
                        <p><strong>Lowest:</strong> @forecasts.Min(f => f.TemperatureC)°C</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card bg-light">
                    <div class="card-body">
                        <h5 class="card-title">ℹ️ About This Data</h5>
                        <p>This weather forecast data is loaded from a JSON file in the wwwroot directory using HttpClient.</p>
                        <p class="text-muted">All data processing happens in your browser - no backend server required!</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private WeatherForecast[]? forecasts;

    protected override async Task OnInitializedAsync()
    {
        forecasts = await Http.GetFromJsonAsync<WeatherForecast[]>("sample-data/weather.json");
    }

    private string GetTempBadgeClass(int temp)
    {
        return temp switch
        {
            >= 25 => "background-color: #dc3545; color: white;", // Red for hot
            >= 15 => "background-color: #ffc107; color: black;",  // Yellow for warm
            >= 5 => "background-color: #17a2b8; color: white;",   // Cyan for cool
            _ => "background-color: #007bff; color: white;"        // Blue for cold
        };
    }

    public class WeatherForecast
    {
        public DateOnly Date { get; set; }

        public int TemperatureC { get; set; }

        public string? Summary { get; set; }

        public int TemperatureF => 32 + (int)(TemperatureC / 0.5556);
    }
}
